using UnrealBuildTool;
public class ImGuiValidationEditorTarget : TargetRules
{
    public ImGuiValidationEditorTarget(TargetInfo Target) : base(Target)
    {
        Type = TargetType.Editor;
        DefaultBuildSettings = BuildSettingsVersion.Latest;
        IncludeOrderVersion = EngineIncludeOrderVersion.Latest;
        ExtraModuleNames.Add("ImGuiValidation");
    }
}
